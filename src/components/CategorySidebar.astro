---
import { categories, categoryLabels } from '../lib/categories';
import type { Category } from '../lib/categories';

interface Props {
    activeCategory?: Category;
}

const { activeCategory } = Astro.props;
---

<nav class="category-sidebar" aria-label="Categorías de lecciones">
    <button
        type="button"
        id="category-sidebar-toggle"
        class="category-sidebar-toggle"
        aria-expanded="true"
        aria-controls="category-sidebar-panel"
    >
        <svg class="icon-hamburger" viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true">
            <path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
            ></path>
        </svg>
        <svg class="icon-close" viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
        </svg>
        <span>Categorías</span>
    </button>
    <div id="category-sidebar-panel" class="category-sidebar-panel">
        <ul>
            <li>
                <a href="/" aria-current={activeCategory === undefined ? 'page' : undefined}>Todo</a>
            </li>
            {
                categories.map((category) => (
                    <li>
                        <a href={`/${category}`} aria-current={activeCategory === category ? 'page' : undefined}>
                            {categoryLabels[category]}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>

<style>
    .category-sidebar-toggle {
        display: none;
        align-items: center;
        gap: 0.5rem;
        min-height: 2.75rem;
        margin-block-end: 0.5rem;
        padding: 0.5rem 0.9rem;
        border: 1px solid #d8dbe3;
        border-radius: 0.5rem;
        background: #fff;
        color: #1c1f26;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
    }

    .category-sidebar-toggle:hover {
        border-color: #364fc7;
    }

    .category-sidebar-toggle:focus-visible {
        outline: 2px solid #364fc7;
        outline-offset: 2px;
    }

    .category-sidebar-toggle .icon-close {
        display: none;
    }

    .category-sidebar-toggle[aria-expanded='true'] .icon-hamburger {
        display: none;
    }

    .category-sidebar-toggle[aria-expanded='true'] .icon-close {
        display: block;
    }

    .category-sidebar-panel ul {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .category-sidebar-panel a {
        display: block;
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
        color: #1c1f26;
        text-decoration: none;
        font-size: 0.95rem;
    }

    .category-sidebar-panel a:hover {
        background: #eef0f4;
    }

    .category-sidebar-panel a[aria-current='page'] {
        background: #364fc7;
        color: #fff;
        font-weight: 600;
    }

    @media (max-width: 640px) {
        .category-sidebar-toggle {
            display: inline-flex;
        }

        .category-sidebar-panel ul {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 0.5rem;
            padding-block-start: 0.5rem;
        }
    }
</style>

<script>
    const toggle = document.querySelector<HTMLButtonElement>('#category-sidebar-toggle');
    const panel = document.querySelector<HTMLElement>('#category-sidebar-panel');

    function setExpanded(expanded: boolean): void {
        toggle?.setAttribute('aria-expanded', String(expanded));
        if (panel) panel.hidden = !expanded;
    }

    if (window.matchMedia('(max-width: 640px)').matches) {
        setExpanded(false);
    }

    toggle?.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        setExpanded(!expanded);
    });
</script>
