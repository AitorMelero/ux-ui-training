---
import type { CollectionEntry } from 'astro:content';

interface Props {
    lesson: CollectionEntry<'lessons'>;
}

const { lesson } = Astro.props;

const levelLabels: Record<CollectionEntry<'lessons'>['data']['level'], string> = {
    beginner: 'Principiante',
    intermediate: 'Intermedio',
    advanced: 'Avanzado',
};
---

<li class="lesson-card" data-lesson-slug={lesson.id}>
    <a href={`/lessons/${lesson.id}`}>
        <span class="lesson-order">Lección {lesson.data.order}</span>
        <span class={`lesson-level lesson-level--${lesson.data.level}`}>{levelLabels[lesson.data.level]}</span>
        <span class="lesson-completed-badge" hidden>✓ Completada</span>
        <h3>{lesson.data.title}</h3>
        <p>{lesson.data.description}</p>
    </a>
</li>

<style>
    .lesson-card {
        list-style: none;
    }

    .lesson-card a {
        display: block;
        height: 100%;
        padding: 1.25rem;
        border: 1px solid #d8dbe3;
        border-radius: 0.75rem;
        text-decoration: none;
        color: inherit;
        background: #fff;
        transition:
            border-color 0.15s ease,
            transform 0.15s ease;
    }

    .lesson-card a:hover,
    .lesson-card a:focus-visible {
        border-color: #364fc7;
        transform: translateY(-2px);
    }

    .lesson-order {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #364fc7;
        margin-block-end: 0.35rem;
        margin-inline-end: 0.5rem;
    }

    .lesson-level {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        margin-block-end: 0.35rem;
    }

    .lesson-level--beginner {
        color: #2f9e44;
        background: #ebfbee;
    }

    .lesson-level--intermediate {
        color: #e8590c;
        background: #fff4e6;
    }

    .lesson-level--advanced {
        color: #9c36b5;
        background: #f8f0fc;
    }

    .lesson-card h3 {
        margin: 0 0 0.4rem;
        font-size: 1.1rem;
    }

    .lesson-card p {
        margin: 0;
        color: #495057;
        font-size: 0.95rem;
    }

    .lesson-completed-badge {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: #2f9e44;
        margin: 0 0 0.35rem;
    }

    .lesson-card.is-completed a {
        border-color: #2f9e44;
        background: #ebfbee;
    }
</style>

<script>
    import { isLessonCompleted } from '../lib/progress';

    function initLessonCard(card: HTMLElement): void {
        const lessonSlug = card.dataset.lessonSlug;
        const badge = card.querySelector<HTMLElement>('.lesson-completed-badge');
        if (!lessonSlug || !badge) return;

        const completed = isLessonCompleted(lessonSlug);
        badge.hidden = !completed;
        card.classList.toggle('is-completed', completed);
    }

    document.querySelectorAll<HTMLElement>('.lesson-card[data-lesson-slug]').forEach(initLessonCard);
</script>
