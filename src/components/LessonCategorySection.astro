---
import LessonCard from './LessonCard.astro';
import { categoryLabels } from '../lib/categories';
import type { Category } from '../lib/categories';
import type { CollectionEntry } from 'astro:content';

type Lesson = CollectionEntry<'lessons'>;
type Level = Lesson['data']['level'];

interface Props {
    category: Category;
    lessons: Lesson[];
    headingLevel?: 'h1' | 'h2';
}

const { category, lessons, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;

const levelOrder: Level[] = ['beginner', 'intermediate', 'advanced'];
const levelLabels: Record<Level, string> = {
    beginner: 'Principiante',
    intermediate: 'Intermedio',
    advanced: 'Avanzado',
};

const byLevel = (level: Level) => lessons.filter((lesson) => lesson.data.level === level);
---

<section class="lesson-group" aria-labelledby={`${category}-heading`}>
    <Heading id={`${category}-heading`}>{categoryLabels[category]}</Heading>
    {
        levelOrder.map((level) => {
            const levelLessons = byLevel(level);
            return (
                levelLessons.length > 0 && (
                    <div class="level-group">
                        <h3 class="level-heading">{levelLabels[level]}</h3>
                        <ul class="lesson-grid">
                            {levelLessons.map((lesson) => (
                                <LessonCard lesson={lesson} />
                            ))}
                        </ul>
                    </div>
                )
            );
        })
    }
</section>

<style>
    .lesson-group {
        margin-block-start: 2.5rem;
    }

    .level-group {
        margin-block-start: 1.75rem;
    }

    .level-group:first-of-type {
        margin-block-start: 1rem;
    }

    .level-heading {
        margin: 0 0 0.75rem;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #495057;
    }

    .lesson-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
        gap: 1rem;
        margin: 1rem 0 0;
        padding: 0;
    }
</style>
