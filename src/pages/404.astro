---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, categoryLabels } from '../lib/categories';
---

<BaseLayout title="Página no encontrada · Aprende UX/UI" description="La página que buscas no existe o se ha movido.">
    <main class="not-found">
        <p class="not-found-code" aria-hidden="true">404</p>
        <h1>Página no encontrada</h1>
        <p class="not-found-message">La lección o página que buscas no existe o se ha movido.</p>
        <a class="not-found-cta" href="/">Volver al inicio</a>
        <nav class="not-found-categories" aria-label="Categorías de lecciones">
            {categories.map((category) => <a href={`/${category}`}>{categoryLabels[category]}</a>)}
        </nav>
    </main>
</BaseLayout>

<style>
    .not-found {
        max-width: 32rem;
        margin: 0 auto;
        padding: 5rem 1.25rem 4rem;
        text-align: center;
    }

    .not-found-code {
        margin: 0;
        font-size: 4rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: #364fc7;
    }

    .not-found h1 {
        margin: 0.5rem 0 0.75rem;
    }

    .not-found-message {
        color: #495057;
        font-size: 1.05rem;
    }

    .not-found-cta {
        display: inline-block;
        margin-block-start: 1.5rem;
        border-radius: 0.5rem;
        background: #364fc7;
        color: #fff;
        padding: 0.6rem 1.1rem;
        font-size: 1rem;
        text-decoration: none;
    }

    .not-found-cta:hover {
        background: #2f3ea3;
    }

    .not-found-categories {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        margin-block-start: 2rem;
        font-size: 0.9rem;
    }
</style>
