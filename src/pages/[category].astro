---
import { getCollection } from 'astro:content';

import LessonCategorySection from '../components/LessonCategorySection.astro';
import LessonFilters from '../components/LessonFilters.astro';
import SidebarLayout from '../layouts/SidebarLayout.astro';
import { categories, categoryLabels } from '../lib/categories';
import type { InferGetStaticPropsType } from 'astro';

export async function getStaticPaths() {
    const lessons = await getCollection('lessons');

    return categories.map((category) => ({
        params: { category },
        props: {
            category,
            lessons: lessons
                .filter((lesson) => lesson.data.category === category)
                .sort((a, b) => a.data.order - b.data.order),
        },
    }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { category, lessons } = Astro.props as Props;
const label = categoryLabels[category];
---

<SidebarLayout
    title={`${label} · Aprende UX/UI`}
    description={`Lecciones de ${label} para dar tus primeros pasos.`}
    activeCategory={category}
>
    <main>
        <LessonFilters />
        <LessonCategorySection category={category} lessons={lessons} headingLevel="h1" />
    </main>
</SidebarLayout>
