---
import { getCollection, render } from 'astro:content';

import ExerciseList from '../../components/ExerciseList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { InferGetStaticPropsType } from 'astro';

export async function getStaticPaths() {
    const lessons = await getCollection('lessons');
    return lessons.map((lesson) => ({
        params: { slug: lesson.id },
        props: { lesson },
    }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lesson } = Astro.props as Props;
const { Content } = await render(lesson);

const categoryLabel = lesson.data.category === 'ux' ? 'User Experience' : 'User Interface';
---

<BaseLayout title={lesson.data.title} description={lesson.data.description}>
    <main class="lesson">
        <a class="back-link" href="/">← Back to all lessons</a>
        <p class="lesson-category">{categoryLabel}</p>
        <h1>{lesson.data.title}</h1>
        <p class="lesson-description">{lesson.data.description}</p>
        <div class="lesson-theory">
            <Content />
        </div>
        <ExerciseList exercises={lesson.data.exercises} />
    </main>
</BaseLayout>

<style>
    .lesson {
        max-width: 42rem;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
    }

    .back-link {
        display: inline-block;
        margin-block-end: 1.5rem;
        font-size: 0.9rem;
        text-decoration: none;
    }

    .back-link:hover {
        text-decoration: underline;
    }

    .lesson-category {
        text-transform: uppercase;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: #364fc7;
        margin: 0;
    }

    .lesson h1 {
        margin-block-start: 0.25rem;
    }

    .lesson-description {
        color: #495057;
        font-size: 1.05rem;
    }

    .lesson-theory {
        line-height: 1.75;
    }

    .lesson-theory :global(h2) {
        margin-block-start: 2rem;
    }

    .lesson-theory :global(p) {
        margin-block: 1rem;
    }

    .lesson-theory :global(ul),
    .lesson-theory :global(ol) {
        padding-inline-start: 1.5rem;
    }

    .lesson-theory :global(code) {
        background: #eef0f4;
        padding: 0.1rem 0.35rem;
        border-radius: 0.3rem;
        font-size: 0.9em;
    }
</style>
