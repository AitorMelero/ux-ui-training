---
import { getCollection } from 'astro:content';

import LessonCategorySection from '../components/LessonCategorySection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

type Lesson = CollectionEntry<'lessons'>;

const lessons = await getCollection('lessons');

const byCategory = (category: 'ux' | 'ui') =>
    lessons.filter((lesson) => lesson.data.category === category).sort((a, b) => a.data.order - b.data.order);

const uxLessons: Lesson[] = byCategory('ux');
const uiLessons: Lesson[] = byCategory('ui');
---

<BaseLayout title="Aprende UX/UI" description="Lecciones interactivas de diseño UX y UI para dar tus primeros pasos.">
    <main class="home">
        <header class="home-header">
            <h1>Aprende UX/UI</h1>
            <p>Lecciones breves de teoría con ejercicios prácticos para reforzar lo aprendido.</p>
        </header>

        <LessonCategorySection category="ux" lessons={uxLessons} />
        <LessonCategorySection category="ui" lessons={uiLessons} />
    </main>
</BaseLayout>

<style>
    .home {
        max-width: 64rem;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
    }

    .home-header h1 {
        margin-block-end: 0.5rem;
    }

    .home-header p {
        color: #495057;
        max-width: 40rem;
    }
</style>
