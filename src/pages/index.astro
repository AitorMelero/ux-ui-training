---
import { getCollection } from 'astro:content';

import LessonCategorySection from '../components/LessonCategorySection.astro';
import LessonFilters from '../components/LessonFilters.astro';
import SidebarLayout from '../layouts/SidebarLayout.astro';
import { categories } from '../lib/categories';

const lessons = await getCollection('lessons');

const byCategory = (category: (typeof categories)[number]) =>
    lessons.filter((lesson) => lesson.data.category === category).sort((a, b) => a.data.order - b.data.order);

const sections = categories.map((category) => ({ category, lessons: byCategory(category) }));
---

<SidebarLayout
    title="Aprende UX/UI"
    description="Lecciones interactivas de diseño UX y UI para dar tus primeros pasos."
>
    <main>
        <header class="home-header">
            <h1>Aprende UX/UI</h1>
            <p>Lecciones breves de teoría con ejercicios prácticos para reforzar lo aprendido.</p>
        </header>

        <LessonFilters />

        {
            sections.map(({ category, lessons: categoryLessons }) => (
                <LessonCategorySection category={category} lessons={categoryLessons} />
            ))
        }
    </main>
</SidebarLayout>

<style>
    .home-header h1 {
        margin-block-end: 0.5rem;
    }

    .home-header p {
        color: #495057;
        max-width: 40rem;
    }
</style>
