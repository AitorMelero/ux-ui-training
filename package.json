{
    "name": "ux-ui-training",
    "private": false,
    "version": "1.3.0",
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "astro check && astro build",
        "preview": "astro preview",
        "check": "pnpm format:check && pnpm lint:js:check && pnpm test:coverage",
        "format:check": "prettier --config .prettierrc --check .",
        "format:fix": "prettier --config .prettierrc --write .",
        "lint:js:check": "eslint .",
        "lint:js:fix": "eslint . --fix",
        "sync": "node scripts/sync-content.mjs",
        "pretest": "pnpm sync",
        "test": "vitest",
        "pretest:coverage": "pnpm sync",
        "test:coverage": "vitest run --coverage",
        "pretest:ui": "pnpm sync",
        "test:ui": "vitest --ui",
        "astro": "astro"
    },
    "dependencies": {
        "astro": "^7.0.7"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@eslint/js": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^24.13.3",
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/ui": "^4.1.10",
        "astro-eslint-parser": "^2.1.0",
        "eslint": "^10.6.0",
        "eslint-plugin-astro": "^2.1.1",
        "globals": "^17.7.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.5",
        "prettier-plugin-astro": "^0.14.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.63.0",
        "vitest": "^4.1.10"
    },
    "packageManager": "pnpm@11.11.0"
}
